pipeline{
    agent any;
    tools {
        nodejs 'nodejs-v24.0.0'
    }
    stages{

        stage("Pull Request"){
            when{
                chagedRequest target: 'main'
            }
            steps{
                sh 'printenv'
            }
        }

        stage("Install Dependencies"){
            steps{
                dir("./client"){
                    sh "npm install --no-audit"
                }
            }
        }

        stage("Run Audit"){
            steps{
                dir("./client"){
                    sh "npm audit --audit-level=high"
                }
            }
        }


        // stage("Owasp Scan"){
        //     steps{
                
        //     }
        // }
    }
}